    "algoliasearch": "^5.59.0",
    "framer-motion": "^14.1.0",
    "mermaid": "^12.1.0",
    "minisearch": "^7.2.0",
    "motion": "^14.1.0",
    "npm-to-yarn": "^3.2.0",
